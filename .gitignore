# Repo-wide safety net. Each part also has its own .gitignore.

# Dependencies
node_modules/
venv/
.venv/

# Secrets: only the .env.example templates are committed
.env
.env.*
!.env.example

# Uploaded footage and generated files
uploads/
__pycache__/
*.pyc
*.log
.DS_Store
.vercel

# Python builds and model weights
*.py[cod]
*.pt

# Builds
dist/
.vite/

# Demo / CCTV footage (the landing-page hero video is the one tracked exception)
*.mp4
*.mov
*.avi
*.mkv
*.webm
clips/
footage/
demo-footage/
detector/out/
!frontend/public/nicked-hero.mp4
