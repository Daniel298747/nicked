# Copy to .env and fill in. Never commit .env.

PORT=4000
APP_NAME=Nicked
DEMO_SHOP_NAME=Demo Corner Shop
CLIENT_URL=http://localhost:5173

# Local: brew services start mongodb-community
# Atlas: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/hackucd_demo
MONGODB_URI=mongodb://127.0.0.1:27017/hackucd

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Any vision-capable model. See options with: npm run models:list
DETECT_MODEL=anthropic/claude-haiku-5.5
# Text model for incident reports (defaults to DETECT_MODEL)
REPORT_MODEL=

# --- YOLO detector (your teammate's Python service) ---
# Leave empty to use the mock detector.
DETECTOR_URL=
# DETECTOR_URL=http://localhost:8000
MIN_SHELF_SECONDS=2
ZONES_FILE=zones.json

# --- Stripe SANDBOX (Dashboard → Developers → API keys, test mode) ---
STRIPE_SECRET_KEY=sk_test_
# Printed by: stripe listen --forward-to localhost:4000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_
# Optional. If empty, the price created by `npm run stripe:seed` is found by lookup key.
STRIPE_PRICE_ID=

# Skip the paywall while building the UI. MUST be false for the demo.
DEV_BYPASS_PAYWALL=false

# --- Tuning (defaults are fine) ---
# SAMPLE_FPS=2
# MAX_FRAMES_PER_EVENT=16
# FRAME_WIDTH=640
# VERIFY_CONCURRENCY=3
# OPENROUTER_TIMEOUT_MS=60000
# MAX_UPLOAD_MB=300
