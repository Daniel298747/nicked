# On Vercel (root vercel.json) the API is on the same domain: leave VITE_API_URL empty,
# the build already sets VITE_LIVE=true.

# The video worker (Dockerfile) that takes uploads and serves footage. Set it in Vercel
# once the worker is deployed; until then uploads explain that analysis isn't connected.
# VITE_WORKER_URL=https://nicked-worker.onrender.com

# Only if the API is on a different domain from the site:
# VITE_API_URL=https://nicked-api.example.com

# Local dev against a backend on localhost:4000 (through Vite's proxy):
# VITE_LIVE=true
# Leave both VITE_LIVE and VITE_API_URL unset for the clickable preview on sample data.
